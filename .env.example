# ── Bot ────────────────────────────────────────────────
DISCORD_TOKEN=ton_token_bot_ici

# ── OAuth2 (Discord Developer Portal → OAuth2) ─────────
CLIENT_ID=123456789012345678
CLIENT_SECRET=ton_client_secret
# Doit être ajoutée telle quelle dans "Redirects" du portail
OAUTH_REDIRECT_URI=https://dashboard.tondomaine.fr/callback

# ── Flask ──────────────────────────────────────────────
# python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET=change_moi_absolument
# Flask n'écoute QUE en local, nginx fait le proxy devant.
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Mettre 0 en dev local (sans HTTPS), 1 en prod derrière nginx
SECURE_COOKIES=1

# ── Divers ─────────────────────────────────────────────
DATABASE_PATH=data/jz.db
OWNER_IDS=123456789012345678
