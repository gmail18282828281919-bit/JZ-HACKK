# Copie ce fichier en .env et adapte-le (ou exporte ces variables).

# Nom du modele expose a l'apk
JZAI_MODEL_NAME=jz-mini-1

# Backend : auto | llama | transformers | echo
JZAI_BACKEND=auto

# Backend llama.cpp -> chemin vers ton fichier .gguf
# JZAI_GGUF_PATH=/home/moi/models/qwen2.5-0.5b-instruct-q4_k_m.gguf

# Backend transformers -> modele HuggingFace
# JZAI_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Token requis pour /admin/keys (laisse vide pour desactiver ces endpoints)
JZAI_ADMIN_TOKEN=change-moi

# Reseau
JZAI_HOST=0.0.0.0
JZAI_PORT=8000

# 0 = aucune limite de requetes/minute par cle
JZAI_RATE_LIMIT=0

# Profil du prompt systeme : general | code
JZAI_PROFILE=general

# Vision : projecteur multimodal du meme modele que JZAI_GGUF_PATH
# JZAI_MMPROJ_PATH=/chemin/vers/mmproj-model-f16.gguf
# JZAI_VISION_HANDLER=llava-1.5
