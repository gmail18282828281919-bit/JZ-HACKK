local function makeESP(p)
    local boxes = {
        box    = newDrawing("Square", { Thickness=1.5, Color=Color3.fromRGB(255,60,60), Filled=false }),
        line   = newDrawing("Line",   { Thickness=1.5, Color=Color3.fromRGB(124,200,255) }),
        name   = newDrawing("Text",   { Size=13, Center=true, Outline=true, Color=Color3.fromRGB(255,255,255) }),
        health = newDrawing("Text",   { Size=12, Center=true, Outline=true, Color=Color3.fromRGB(52,199,89) }),
        dist   = newDrawing("Text",   { Size=12, Center=true, Outline=true, Color=Color3.fromRGB(255,255,255) }),
    }
    ESPObjects[p] = boxes
end

local function updateESP()
    for p, b in pairs(ESPObjects) do
        local on = Config.ESP.enabled and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not on then
            for _, d in pairs(b) do d.Visible = false end
            continue
        end
        local hrp = p.Character.HumanoidRootPart
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        local pos = hrp.Position
        local onScreen, sp = Camera:WorldToViewportPoint(pos)
        if not onScreen then
            for _, d in pairs(b) do d.Visible = false end
            continue
        end

        local dist = (Camera.CFrame.Position - pos).Magnitude
        local scale = math.clamp(5.5 / dist, 0.08, 1.5)
        local h, w = 6 * scale, 4 * scale
        local x, y = sp.X, sp.Y

        local ally = Config.Aimbot.teamcheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team
        local col = ally and Color3.fromRGB(0,200,255) or Color3.fromRGB(255,60,60)

        b.box.Visible = Config.ESP.boxes
        if Config.ESP.boxes then
            b.box.Color = col
            b.box.Position = Vector2.new(x - w, y - h)
            b.box.Size = Vector2.new(w * 2, h * 2)
        end

        b.line.Visible = Config.ESP.tracers
        if Config.ESP.tracers then
            b.line.From = Vector2.new(ScreenSize.X / 2, ScreenSize.Y)
            b.line.To = Vector2.new(x, y)
            b.line.Color = col
        end

        b.name.Visible = Config.ESP.names
        if Config.ESP.names then
            b.name.Position = Vector2.new(x, y - h - 28)
            b.name.Text = p.Name
        end

        b.health.Visible = Config.ESP.health and hum
        if Config.ESP.health and hum then
            b.health.Position = Vector2.new(x, y - h - 14)
            b.health.Text = math.floor(hum.Health) .. " HP"
            b.health.Color = (hum.Health / hum.MaxHealth) > 0.5 and Color3.fromRGB(52,199,89) or ((hum.Health / hum.MaxHealth) > 0.25 and Color3.fromRGB(255,208,45) or Color3.fromRGB(255,60,60))
        end

        b.dist.Visible = Config.ESP.distance
        if Config.ESP.distance then
            b.dist.Position = Vector2.new(x, y + h + 2)
            b.dist.Text = math.floor(dist) .. " studs"
        end
    end
end

