    addSlider(m, "JumpPower", function() return Config.Movement.jump end, function(v) Config.Movement.jump = v end, 50, 400, 10, 248)

    -- === Visuels ===
    local v = tabContent[4]
    addToggle(v, "Fullbright", function() return Config.Visuals.fullbright end, function(val) Config.Visuals.fullbright = val applyVisuals() end, 4)
    addToggle(v, "No Fog", function() return Config.Visuals.nofog end, function(val) Config.Visuals.nofog = val applyVisuals() end, 52)
    addToggle(v, "3ème personne", function() return Config.Visuals.thirdperson end, function(val) Config.Visuals.thirdperson = val applyVisuals() end, 100)
    addToggle(v, "Spinbot", function() return Config.Visuals.spin end, function(val) Config.Visuals.spin = val end, 148)
    addSlider(v, "FOV", function() return Config.Visuals.fov end, function(val) Config.Visuals.fov = val applyVisuals() end, 40, 140, 1, 196)

    -- === Joueurs ===
    local pl = tabContent[5]
    local function refreshPlayers()
        for _, child in ipairs(pl:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local py = 4
        for _, p in ipairs(Players:GetPlayers()) do
            addPlayerRow(pl, p, py)
            py = py + 46
        end
    end
    refreshPlayers()
    Players.PlayerAdded:Connect(refreshPlayers)
    Players.PlayerRemoving:Connect(refreshPlayers)

    -- === Onglet MURDER (seulement si on est dans un jeu Murder) ===
    if isMurderGame then
