        fcorner3.CornerRadius = UDim.new(1, 0)
        fcorner3.Parent = fill

        local function refresh()
            local v = getter()
            label.Text = text .. ": " .. tostring(math.floor(v * 100) / 100)
            fill.Size = UDim2.new(math.clamp((v - min) / (max - min), 0, 1), 0, 1, 0)
        end
        refresh()

        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                local dragging2 = true
                local conn
                conn = UserInput.InputChanged:Connect(function(ci)
                    if dragging2 and (ci.UserInputType == Enum.UserInputType.MouseMovement or ci.UserInputType == Enum.UserInputType.Touch) then
                        local rel = math.clamp((ci.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                        local v = min + (max - min) * rel
                        v = math.floor(v / step + 0.5) * step
                        setter(v)
                        refresh()
                    end
                end)
                UserInput.InputEnded:Connect(function(ei)
                    if ei.UserInputType == Enum.UserInputType.Touch or ei.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging2 = false
                        conn:Disconnect()
                    end
                end)
            end
        end)
        return row
    end

    local function addPlayerRow(parent, p, y)
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -8, 0, 40)
        row.Position = UDim2.new(0, 4, 0, y)
        row.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        row.BackgroundTransparency = 0.88
        row.Text = "  " .. p.Name
        row.TextColor3 = Color3.fromRGB(235, 235, 235)
        row.TextSize = 14
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.Font = Enum.Font.Gotham
        row.Parent = parent
        local rcorner = Instance.new("UICorner")
        rcorner.CornerRadius = UDim.new(0, 8)
        rcorner.Parent = row
        row.MouseButton1Click:Connect(function() teleportTo(p) end)
        row.MouseButton2Click:Connect(function() spectate(p) end)
        return row
    end

