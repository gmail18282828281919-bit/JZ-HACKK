        addToggle(mcontent, "Afficher le MEURTRIER", function() return MurderHighlight.revealMurderer end, function(v) MurderHighlight.revealMurderer = v applyMurderHighlight() end, 52)
        addToggle(mcontent, "Afficher le SHÉRIF", function() return MurderHighlight.revealSheriff end, function(v) MurderHighlight.revealSheriff = v applyMurderHighlight() end, 100)

        -- bouton "re-scanner les rôles"
