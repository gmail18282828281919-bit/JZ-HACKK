        rescan.TextSize = 14
        rescan.Font = Enum.Font.GothamBold
        rescan.Parent = mcontent
        local rcorner2 = Instance.new("UICorner")
        rcorner2.CornerRadius = UDim.new(0, 8)
        rcorner2.Parent = rescan
        rescan.MouseButton1Click:Connect(function() applyMurderHighlight() end)
    end

    return frame
end

