local function toggleFly(on)
    flying = on
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if on then
        hum.PlatformStand = true
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.D = 100
        bodyGyro.P = 10000
        bodyGyro.Parent = hrp
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVel.Velocity = Vector3.zero
        bodyVel.Parent = hrp
    else
        hum.PlatformStand = false
        if bodyGyro then bodyGyro:Destroy() end
        if bodyVel then bodyVel:Destroy() end
        bodyGyro, bodyVel = nil, nil
    end
end

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum then return end

    hum.WalkSpeed = Config.Movement.speed
    hum.JumpPower = Config.Movement.jump

    if flying and hrp and bodyVel then
        local fwd = Camera.CFrame.LookVector
        local right = Camera.CFrame.RightVector
        local x = (UserInput:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInput:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
        local z = (UserInput:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInput:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
        local move = (fwd * x) + (right * z)
        if move.Magnitude > 0 then move = move.Unit * 60 end
        move = move + Vector3.new(0, (UserInput:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) * 60 - (UserInput:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or 0) * 60, 0)
        flyVel = flyVel:Lerp(move, 0.25)
        bodyVel.Velocity = flyVel
        bodyGyro.CFrame = Camera.CFrame
    end

    if Config.Movement.noclip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if Config.Movement.infjump and hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    if Config.Visuals.spin and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(8), 0)
    end
end)

RunService.Stepped:Connect(function()
    if not Config.Movement.bhop then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.MoveDirection.Magnitude > 0 and hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

