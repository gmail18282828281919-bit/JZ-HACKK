-- Détecte le rôle d'un joueur (meurtrier / shérif / innocent)
local function detectRole(p)
    if not p.Character then return "innocent" end
    local function hasTool(container, patterns)
        for _, v in ipairs(container:GetChildren()) do
            if v:IsA("Tool") then
                local n = v.Name:lower()
                for _, pat in ipairs(patterns) do
                    if n:find(pat) then return true end
                end
            end
        end
        return false
    end
    local char = p.Character
    local knife = hasTool(char, { "knife", "knif", "murder", "blade", "couteau" })
    local gun   = hasTool(char, { "gun", "pistol", "revolver", "sheriff", "pistolet" })
    local bp = p:FindFirstChild("Backpack")
    if bp then
        knife = knife or hasTool(bp, { "knife", "knif", "murder", "blade", "couteau" })
        gun   = gun or hasTool(bp, { "gun", "pistol", "revolver", "sheriff", "pistolet" })
    end
    if gun then return "sheriff" end
    if knife then return "murderer" end
    return "innocent"
end

-- met en surbrillance le meurtrier (rouge) et le shérif (bleu)
local MurderHighlight = { enabled = true, revealMurderer = true, revealSheriff = true }

local function applyMurderHighlight()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local role = detectRole(p)
        local target = nil
        if role == "murderer" and MurderHighlight.revealMurderer then target = Color3.fromRGB(255, 40, 40) end
        if role == "sheriff" and MurderHighlight.revealSheriff then target = Color3.fromRGB(60, 140, 255) end
        if target then
            for _, v in ipairs(p.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.Neon
                    v.Color = target
                end
            end
        end
    end
end

