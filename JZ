local function getHrp(p) return p.Character and p.Character:FindFirstChild("HumanoidRootPart") end

local function teleportTo(p)
    local my, hrp = getHrp(LocalPlayer), getHrp(p)
    if my and hrp then my.CFrame = hrp.CFrame * CFrame.new(0, 4, 0) end
