# Service du DASHBOARD seul, ecoute uniquement en local : nginx est devant.
[Unit]
Description=ModeraBot - dashboard web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moderabot
Group=moderabot
WorkingDirectory=/opt/moderabot
ExecStart=/opt/moderabot/venv/bin/gunicorn -w 2 -k gthread --threads 4 \
          -b 127.0.0.1:5000 --access-logfile - wsgi:app
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/moderabot/data
ProtectKernelTunables=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
